<%- include('partials/header') %>

<h1><%= item ? '編輯' : '新增' %>最新消息</h1>

<form method="POST" action="<%= item ? `/admin/news/${item.id}` : '/admin/news' %>" enctype="multipart/form-data" class="admin-form">
  <div class="form-row">
    <label>標題 (中文)<input type="text" name="title_zh" value="<%= item ? item.title_zh : '' %>" required></label>
    <label>標題 (English)<input type="text" name="title_en" value="<%= item ? item.title_en : '' %>" required></label>
  </div>
  <div class="form-row">
    <label>摘要 (中文)<textarea name="summary_zh"><%= item ? item.summary_zh : '' %></textarea></label>
    <label>摘要 (English)<textarea name="summary_en"><%= item ? item.summary_en : '' %></textarea></label>
  </div>

  <label>Slug (內部連結用，留空自動生成)<input type="text" name="slug" value="<%= item ? item.slug : '' %>"></label>

  <label>連結類型
    <select name="link_type">
      <option value="external" <%= item && item.link_type==='external' ? 'selected' : '' %>>外部連結</option>
      <option value="internal" <%= item && item.link_type==='internal' ? 'selected' : '' %>>內部詳情頁</option>
    </select>
  </label>
  <label>外部連結網址 (link_type=external 時使用)<input type="text" name="link_url" value="<%= item ? item.link_url : '' %>"></label>

  <div class="form-row">
    <label>內文 (中文，內部頁用)<textarea name="content_zh" rows="6"><%= item ? item.content_zh : '' %></textarea></label>
    <label>內文 (English)<textarea name="content_en" rows="6"><%= item ? item.content_en : '' %></textarea></label>
  </div>

  <label>封面圖<input type="file" name="cover_image" accept="image/*"></label>
  <% if (item && item.cover_image) { %>
    <img class="thumb-preview" src="<%= item.cover_image %>">
    <input type="hidden" name="existing_cover" value="<%= item.cover_image %>">
  <% } %>

  <div class="form-row">
    <label>排序<input type="number" name="sort_order" value="<%= item ? item.sort_order : 0 %>"></label>
    <label class="checkbox"><input type="checkbox" name="is_published" <%= (!item || item.is_published) ? 'checked' : '' %>> 已發佈</label>
  </div>

  <button type="submit" class="btn">儲存</button>
  <a href="/admin/news" class="btn-secondary">取消</a>
</form>

<%- include('partials/footer') %>
